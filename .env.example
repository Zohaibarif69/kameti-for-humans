# --- Database ---
# Any Postgres connection string works (Neon/Supabase free tier are fastest to set up).
DATABASE_URL="postgresql://user:password@host:5432/kameti"

# --- Agent service (Python, Strands + Gemini) ---
# The actual agent now runs in the separate agent-service/ deployment — see
# agent-service/README.md for setup. These two must match that service's own
# env exactly.
AGENT_SERVICE_URL="http://localhost:8000"
INTERNAL_AGENT_SECRET=""

# --- AWS / Bedrock — legacy, only needed if you revert to the original
# TS/Bedrock agent (see agent-service/README.md "Reverting to Bedrock").
# Not read by the app while AGENT_SERVICE_URL is set.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_ID="global.anthropic.claude-sonnet-4-6"

# --- Twilio (WhatsApp reminders) ---
# Leave these blank to run in mock mode (reminders are logged, not sent) —
# useful while you build, before you've set up a real Twilio sandbox.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
