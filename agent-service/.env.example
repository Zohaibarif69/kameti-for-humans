# --- Google Gemini (free tier, no card, from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=""
GEMINI_MODEL_ID="gemini-2.5-flash"

# --- The main Next.js app this service calls back into for all DB access ---
# Local dev: http://localhost:3000
# Production: your deployed Kameti app's URL, e.g. https://kameti.vercel.app
NEXTJS_BASE_URL="http://localhost:3000"

# --- Shared secret ---
# Must exactly match INTERNAL_AGENT_SECRET in the Next.js app's own .env.
# Generate one with: openssl rand -hex 32
INTERNAL_AGENT_SECRET=""
